[Unit]
Description=Apache HiveServer2
After=network-online.target hive-metastore.service
Wants=network-online.target
Requires=hive-metastore.service

[Service]
User=hive
Group=hive
WorkingDirectory=/var/lib/hive
Environment=JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64
Environment=HADOOP_HOME=/opt/hadoop
Environment=HADOOP_MAPRED_HOME=/opt/hadoop
Environment=HADOOP_CONF_DIR=/etc/hadoop/yarn-conf
Environment=HIVE_HOME=/opt/hive
Environment=HIVE_CONF_DIR=/etc/hive/metastore
Environment=HIVESERVER2_PID_DIR=/run/hive-server2
Environment=HADOOP_HEAPSIZE=768
RuntimeDirectory=hive-server2
ExecStart=/opt/hive/bin/hive --service hiveserver2
Restart=on-failure
RestartSec=10
UMask=0027

[Install]
WantedBy=multi-user.target
