[Unit]
Description=Apache Hadoop MapReduce JobHistoryServer
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=mapred
Group=hadoop
Environment=HADOOP_HOME=/opt/hadoop
Environment=HADOOP_MAPRED_HOME=/opt/hadoop
Environment=HADOOP_CONF_DIR=/etc/hadoop/yarn-conf
Environment=HADOOP_LOG_DIR=/var/log/hadoop-mapred
Environment=HADOOP_PID_DIR=/run/mapred-historyserver
RuntimeDirectory=mapred-historyserver
ExecStart=/opt/hadoop/bin/mapred historyserver
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
